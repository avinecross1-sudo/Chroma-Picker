{
  "id": "com.chromapicker.panel",
  "name": "Chroma Picker",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "PS", "minVersion": "23.3.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "chromaPickerPanel",
      "label": { "default": "Chroma Picker" },
      "minimumSize": { "width": 250, "height": 360 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 300, "height": 760 },
      "preferredFloatingSize": { "width": 320, "height": 800 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "request"
  }
}
